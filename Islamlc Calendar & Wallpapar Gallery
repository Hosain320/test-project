<!-- Islamic Calendar & Wallpaper Gallery -->
<div class="wallpaper-container">
  <div class="wallpaper-header">
    <h3>ইসলামিক ক্যালেন্ডার ও ওয়ালপেপার</h3>
    <p>ডেস্কটপ ও মোবাইলের জন্য এইচডি ব্যাকগ্রাউন্ড ডাউনলোড করুন</p>
  </div>

  <!-- Filter Buttons -->
  <div class="filter-btn-group">
    <button onclick="filterGallery('all')" class="filter-btn active">সবগুলো</button>
    <button onclick="filterGallery('calendar')" class="filter-btn">ক্যালেন্ডার</button>
    <button onclick="filterGallery('desktop')" class="filter-btn">ডেস্কটপ</button>
    <button onclick="filterGallery('mobile')" class="filter-btn">মোবাইল</button>
  </div>

  <!-- Gallery Grid -->
  <div class="gallery-grid">
    
    <!-- Item 1: Calendar -->
    <div class="gallery-card calendar">
      <div class="img-box">
        <img src="https://images.unsplash.com/photo-1564769625905-50e93615e769?w=500&auto=format&fit=crop" alt="Islamic Calendar 2026">
        <span class="badge">২০২৬ ক্যালেন্ডার</span>
      </div>
      <div class="card-body">
        <h4>রমজান ও হিজরী ক্যালেন্ডার ২০২৬</h4>
        <a href="https://images.unsplash.com/photo-1564769625905-50e93615e769?w=1600&auto=format&fit=crop" download="Islamic_Calendar_2026.jpg" target="_blank" class="download-btn">⬇️ ডাউনলোড (HD)</a>
      </div>
    </div>

    <!-- Item 2: Desktop Wallpaper -->
    <div class="gallery-card desktop">
      <div class="img-box">
        <img src="https://images.unsplash.com/photo-1542816417-0983c9c9ad53?w=500&auto=format&fit=crop" alt="Mosque Desktop Wallpaper">
        <span class="badge">ডেস্কটপ (1920x1080)</span>
      </div>
      <div class="card-body">
        <h4>মসজিদুল নববী এইচডি ব্যাকগ্রাউন্ড</h4>
        <a href="https://images.unsplash.com/photo-1542816417-0983c9c9ad53?w=1920&auto=format&fit=crop" download="Mosque_Desktop_Wallpaper.jpg" target="_blank" class="download-btn">⬇️ ডাউনলোড (HD)</a>
      </div>
    </div>

    <!-- Item 3: Mobile Wallpaper -->
    <div class="gallery-card mobile">
      <div class="img-box">
        <img src="https://images.unsplash.com/photo-1590076175571-4b5459efb08c?w=500&auto=format&fit=crop" alt="Kaaba Mobile Wallpaper">
        <span class="badge">মোবাইল (1080x1920)</span>
      </div>
      <div class="card-body">
        <h4>কাবা শরীফ মোবাইল ব্যাকগ্রাউন্ড</h4>
        <a href="https://images.unsplash.com/photo-1590076175571-4b5459efb08c?w=1080&auto=format&fit=crop" download="Kaaba_Mobile_Wallpaper.jpg" target="_blank" class="download-btn">⬇️ ডাউনলোড (HD)</a>
      </div>
    </div>

  </div>
</div>

<style>
.wallpaper-container {
  max-width: 800px;
  margin: 20px auto;
  padding: 20px;
  background: #ffffff;
  border-radius: 12px;
  box-shadow: 0 4px 15px rgba(0,0,0,0.08);
  font-family: Arial, sans-serif;
  border-top: 4px solid #0f5132;
}

.wallpaper-header {
  text-align: center;
  margin-bottom: 20px;
}

.wallpaper-header h3 {
  margin: 0;
  color: #0f5132;
  font-size: 22px;
}

.wallpaper-header p {
  margin: 5px 0 0 0;
  color: #666;
  font-size: 13px;
}

.filter-btn-group {
  display: flex;
  justify-content: center;
  gap: 8px;
  margin-bottom: 20px;
  flex-wrap: wrap;
}

.filter-btn {
  padding: 6px 14px;
  border: 1px solid #0f5132;
  background: transparent;
  color: #0f5132;
  border-radius: 20px;
  cursor: pointer;
  font-size: 13px;
  font-weight: 500;
  transition: all 0.2s ease;
}

.filter-btn:hover, .filter-btn.active {
  background: #0f5132;
  color: #ffffff;
}

.gallery-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 15px;
}

.gallery-card {
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  overflow: hidden;
  background: #f8f9fa;
  display: flex;
  flex-direction: column;
}

.img-box {
  position: relative;
  height: 140px;
  overflow: hidden;
}

.img-box img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.gallery-card:hover .img-box img {
  transform: scale(1.05);
}

.badge {
  position: absolute;
  top: 8px;
  left: 8px;
  background: rgba(15, 81, 50, 0.85);
  color: #ffffff;
  font-size: 10px;
  padding: 3px 8px;
  border-radius: 4px;
}

.card-body {
  padding: 12px;
  text-align: center;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  flex-grow: 1;
}

.card-body h4 {
  margin: 0 0 10px 0;
  font-size: 13px;
  color: #1e293b;
}

.download-btn {
  display: inline-block;
  padding: 8px;
  background: #0f5132;
  color: #ffffff;
  text-decoration: none;
  border-radius: 6px;
  font-size: 12px;
  font-weight: bold;
  transition: background 0.2s ease;
}

.download-btn:hover {
  background: #14532d;
}
</style>

<script>
function filterGallery(category) {
  // সক্রিয় বাটন পরিবর্তন
  const buttons = document.querySelectorAll('.filter-btn');
  buttons.forEach(btn => btn.classList.remove('active'));
  event.target.classList.add('active');

  // আইটেম ফিল্টার করা
  const items = document.querySelectorAll('.gallery-card');
  items.forEach(item => {
    if (category === 'all' || item.classList.contains(category)) {
      item.style.display = 'flex';
    } else {
      item.style.display = 'none';
    }
  });
}
</script>
