<!-- Digital Tasbeeh Counter -->
<div class="tasbeeh-container">
  <div class="tasbeeh-screen">
    <span id="tasbeeh-count">০</span>
  </div>

  <div class="tasbeeh-target-info">
    <span id="tasbeeh-title">সুবহানাল্লাহ</span>
  </div>

  <div class="tasbeeh-controls">
    <button onclick="countUp()" class="count-btn">গণনা করুন</button>
    <div class="sub-controls">
      <button onclick="resetCount()" class="reset-btn">রিসেট</button>
      <select id="phrase-select" onchange="changePhrase()">
        <option value="সুবহানাল্লাহ">সুবহানাল্লাহ</option>
        <option value="আলহামদুলিল্লাহ">আলহামদুলিল্লাহ</option>
        <option value="আল্লাহু আকবার">আল্লাহু আকবার</option>
        <option value="লা ইলাহা ইল্লাল্লাহ">লা ইলাহা ইল্লাল্লাহ</option>
        <option value="আস্তাগফিরুল্লাহ">আস্তাগফিরুল্লাহ</option>
      </select>
    </div>
  </div>
</div>

<style>
.tasbeeh-container {
  max-width: 320px;
  margin: 20px auto;
  padding: 25px 20px;
  background: #111827;
  border-radius: 20px;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
  text-align: center;
  font-family: Arial, sans-serif;
  border: 2px solid #0f5132;
}

.tasbeeh-screen {
  background: #000000;
  border: 2px solid #0f5132;
  border-radius: 12px;
  padding: 15px;
  margin-bottom: 12px;
  box-shadow: inset 0 0 10px rgba(15, 81, 50, 0.5);
}

#tasbeeh-count {
  font-size: 48px;
  font-weight: bold;
  color: #22c55e;
  letter-spacing: 2px;
  font-family: 'Courier New', Courier, monospace;
}

.tasbeeh-target-info {
  margin-bottom: 20px;
}

#tasbeeh-title {
  color: #e5e7eb;
  font-size: 18px;
  font-weight: 500;
}

.count-btn {
  width: 100%;
  height: 90px;
  border-radius: 50px;
  border: none;
  background: linear-gradient(145deg, #0f5132, #14532d);
  color: #ffffff;
  font-size: 20px;
  font-weight: bold;
  cursor: pointer;
  box-shadow: 0 6px 0 #052e16, 0 10px 15px rgba(0,0,0,0.4);
  transition: all 0.1s ease;
  margin-bottom: 20px;
}

.count-btn:active {
  transform: translateY(4px);
  box-shadow: 0 2px 0 #052e16, 0 5px 10px rgba(0,0,0,0.4);
}

.sub-controls {
  display: flex;
  gap: 10px;
  justify-content: space-between;
}

.reset-btn {
  padding: 8px 15px;
  background: #ef4444;
  color: white;
  border: none;
  border-radius: 6px;
  font-size: 13px;
  cursor: pointer;
  font-weight: bold;
}

.reset-btn:hover {
  background: #dc2626;
}

#phrase-select {
  padding: 8px;
  background: #1f2937;
  color: #ffffff;
  border: 1px solid #374151;
  border-radius: 6px;
  font-size: 13px;
  outline: none;
  cursor: pointer;
}
</style>

<script>
let count = 0;

// সংখ্যা ইংরেজী থেকে বাংলায় রূপান্তর
function toBengaliNumerals(num) {
  const bn = {'0':'০','1':'১','2':'২','3':'৩','4':'৪','5':'৫','6':'৬','7':'৭','8':'৮','9':'৯'};
  return num.toString().replace(/[0-9]/g, w => bn[w]);
}

// লোকাল স্টোরেজ থেকে ডাটা লোড করা
function loadSavedData() {
  const savedCount = localStorage.getItem('tasbeeh_count');
  const savedPhrase = localStorage.getItem('tasbeeh_phrase');
  
  if (savedCount !== null) {
    count = parseInt(savedCount);
  }
  if (savedPhrase !== null) {
    document.getElementById('phrase-select').value = savedPhrase;
    document.getElementById('tasbeeh-title').innerText = savedPhrase;
  }
  
  updateDisplay();
}

// কাউন্ট বাড়ানো
function countUp() {
  count++;
  localStorage.setItem('tasbeeh_count', count);
  updateDisplay();
}

// রিসেট করা
function resetCount() {
  if (confirm("আপনি কি সংখ্যাটি জিরো (০) করতে চান?")) {
    count = 0;
    localStorage.setItem('tasbeeh_count', count);
    updateDisplay();
  }
}

// জিকির পরিবর্তন করা
function changePhrase() {
  const selectedPhrase = document.getElementById('phrase-select').value;
  document.getElementById('tasbeeh-title').innerText = selectedPhrase;
  localStorage.setItem('tasbeeh_phrase', selectedPhrase);
}

// ডিসপ্লে আপডেট
function updateDisplay() {
  document.getElementById('tasbeeh-count').innerText = toBengaliNumerals(count);
}

// প্রথমবার রান করা
loadSavedData();
</script>
