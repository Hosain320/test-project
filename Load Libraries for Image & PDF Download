<!-- Load Libraries for Image & PDF Download -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

<div class="calendar-wrapper">
  <!-- Action Buttons -->
  <div class="btn-group">
    <button onclick="downloadAsPDF()" class="dl-btn pdf-btn">📄 PDF ডাউনলোড</button>
    <button onclick="downloadAsImage()" class="dl-btn img-btn">🖼️ Image (ছবি) ডাউনলোড</button>
  </div>

  <!-- Downloadable Schedule Area -->
  <div id="ramadan-schedule" class="schedule-card">
    <div class="schedule-header">
      <h2>মাহে রমজান ও সেহরি-ইফতারের সময়সূচী</h2>
      <p>ঢাকা ও পার্শ্ববর্তী এলাকার জন্য প্রযোজ্য</p>
    </div>

    <table class="schedule-table">
      <thead>
        <tr>
          <th>রমজান</th>
          <th>তারিখ</th>
          <th>বার</th>
          <th>সেহরির শেষ সময়</th>
          <th>ইফতারের সময়</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>১ম</td>
          <td>১ মার্চ</td>
          <td>শনিবার</td>
          <td>৪:৫২ AM</td>
          <td>৬:০২ PM</td>
        </tr>
        <tr>
          <td>২য়</td>
          <td>২ মার্চ</td>
          <td>রবিবার</td>
          <td>৪:৫১ AM</td>
          <td>৬:০২ PM</td>
        </tr>
        <tr>
          <td>৩য়</td>
          <td>৩ মার্চ</td>
          <td>সোমবার</td>
          <td>৪:৫০ AM</td>
          <td>৬:০৩ PM</td>
        </tr>
        <tr>
          <td>৪র্থ</td>
          <td>৪ মার্চ</td>
          <td>মঙ্গলবার</td>
          <td>৪:৪৯ AM</td>
          <td>৬:০৩ PM</td>
        </tr>
        <tr>
          <td>৫ম</td>
          <td>৫ মার্চ</td>
          <td>বুধবার</td>
          <td>৪:৪৮ AM</td>
          <td>৬:০৪ PM</td>
        </tr>
      </tbody>
    </table>
    
    <div class="schedule-footer">
      <p>ওয়েবসাইট: yourwebsite.com | সতর্কবার্তা: ১ মিনিট সতর্কতা অবলম্বন করুন</p>
    </div>
  </div>
</div>

<style>
.calendar-wrapper {
  max-width: 600px;
  margin: 20px auto;
  font-family: Arial, sans-serif;
}

.btn-group {
  display: flex;
  gap: 10px;
  margin-bottom: 15px;
  justify-content: center;
}

.dl-btn {
  padding: 10px 18px;
  border: none;
  border-radius: 6px;
  font-size: 14px;
  font-weight: bold;
  cursor: pointer;
  transition: 0.2s;
  color: white;
}

.pdf-btn { background-color: #dc3545; }
.pdf-btn:hover { background-color: #bb2d3b; }

.img-btn { background-color: #198754; }
.img-btn:hover { background-color: #157347; }

.schedule-card {
  background: #ffffff;
  padding: 20px;
  border-radius: 10px;
  border: 1px solid #e0e0e0;
  box-shadow: 0 4px 10px rgba(0,0,0,0.05);
}

.schedule-header {
  text-align: center;
  border-bottom: 2px solid #0f5132;
  padding-bottom: 10px;
  margin-bottom: 15px;
}

.schedule-header h2 {
  margin: 0;
  color: #0f5132;
  font-size: 20px;
}

.schedule-header p {
  margin: 4px 0 0 0;
  color: #666;
  font-size: 13px;
}

.schedule-table {
  width: 100%;
  border-collapse: collapse;
  text-align: center;
}

.schedule-table th {
  background-color: #0f5132;
  color: white;
  padding: 8px;
  font-size: 13px;
}

.schedule-table td {
  padding: 8px;
  border-bottom: 1px solid #ddd;
  font-size: 13px;
  color: #333;
}

.schedule-table tbody tr:nth-child(even) {
  background-color: #f8f9fa;
}

.schedule-footer {
  text-align: center;
  margin-top: 15px;
  font-size: 11px;
  color: #777;
}
</style>

<script>
// PDF ডাউনলোড ফাংশন
function downloadAsPDF() {
  const element = document.getElementById('ramadan-schedule');
  const opt = {
    margin:       0.3,
    filename:     'Ramadan_Schedule.pdf',
    image:        { type: 'jpeg', quality: 0.98 },
    html2canvas:  { scale: 2 },
    jsPDF:        { unit: 'in', format: 'letter', orientation: 'portrait' }
  };
  html2pdf().set(opt).from(element).save();
}

// Image (PNG) ডাউনলোড ফাংশন
function downloadAsImage() {
  const element = document.getElementById('ramadan-schedule');
  html2canvas(element, { scale: 2 }).then(canvas => {
    const link = document.createElement('a');
    link.download = 'Ramadan_Schedule.png';
    link.href = canvas.toDataURL('image/png');
    link.click();
  });
}
</script>
